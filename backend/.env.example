# Every variable is optional; the defaults run the API with nothing set.

# Comma-separated browser origins allowed to call the API, no trailing slash.
# The deployed frontend is blocked until its exact origin is listed here.
#ALLOWED_ORIGINS=http://localhost:3000

# Demo model training settings. Changing any of them changes every answer
# and the model fingerprint that /health, /model, and every result report.
#MODEL_SEED=42
#CAPTURES_PER_CLASS=100
#WINDOWS_PER_CAPTURE=4

# Analyzed recordings kept in memory for follow-up reads (a window's plots,
# the CSV, re-preparing). Nothing is written to disk.
#RUN_CACHE_SIZE=32
#RUN_TTL_SECONDS=1800

# Largest request body /analyze accepts, in bytes (the CSV reader has its
# own 6 MB limit).
#MAX_UPLOAD_BYTES=8000000
